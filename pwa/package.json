{
  "name": "termote",
  "private": true,
  "version": "2.11.0",
  "description": "PWA for remotely controlling CLI tools from mobile/desktop",
  "author": "Lam Ngoc Khuong <hi@khuong.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamngockhuong/termote.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
